{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "abal",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#reserved"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.abal",
					"match": "\\b(if|while|return|else|elif)\\b"
				},
				{
					"name": "keyword.other.abal",
					"match": "\\b(func|int|char|bool)\\b"
				}
			]
		},
		"reserved": {
			"name": "entity.name.function.abal",
			"match": "\\b(print|length|str_to_int|int_to_str|array_to_str)\\b"
		},
		"functions": {
			"name": "entity.name.function.abal",
    		"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
		},
		"strings": {
			"name": "string.quoted.double.abal",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.abal",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.abal",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		}
	},
	"scopeName": "source.abal"
}